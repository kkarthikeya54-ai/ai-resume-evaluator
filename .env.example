# Firebase
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# AI proxy — Cloudflare Worker with a Gemini → NVIDIA fallback chain.
# Get a free Gemini key at https://aistudio.google.com/apikey and a free
# NVIDIA key at https://build.nvidia.com, then set BOTH as worker secrets
# (never client-side): see worker/README.md for the 5-minute setup.
# This is the ONLY AI variable the client needs — keys stay server-side.
VITE_AI_PROXY_URL=https://ai-proxy.YOUR_SUBDOMAIN.workers.dev

# Supabase Storage — free 1GB tier for cloud resume file storage.
# Create a project at https://supabase.com, add a PUBLIC bucket named
# `resumes`, then fill in the project URL and anon key from
# Project Settings → API Keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase Cloud Functions (HR), e.g. https://us-central1-your-project.cloudfunctions.net
# VITE_FUNCTIONS_BASE_URL=
